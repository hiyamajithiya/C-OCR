# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/c_ocr
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/c_ocr

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage Configuration
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE=52428800

# Security
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
API_KEY_HASH_SALT=your-salt-change-this-in-production

# OCR Configuration
OCR_ENGINE_PRIMARY=paddle
OCR_ENGINE_FALLBACK=tesseract
OCR_LANGS=en
DEFAULT_DPI=300

# Template Configuration
TEMPLATE_MATCH_THRESHOLD=0.75

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4
RELOAD=true

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Multi-tenancy
MULTI_TENANT_MODE=true
DEFAULT_TENANT_NAME=Default Tenant

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_DAILY_QUOTA=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
